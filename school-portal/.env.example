# Copy to .env and fill in real values for anything beyond local dev.

# PostgreSQL connection string. The README's local setup steps create a
# matching local role/database with these exact credentials.
DATABASE_URL="postgresql://school_portal:school_portal_dev@localhost:5432/school_portal?schema=public"

# Narrowly-scoped role used only for the pre-authentication user lookup
# (SELECT-only on User, BYPASSRLS — see README setup + SECURITY.md).
DATABASE_URL_AUTH="postgresql://school_portal_auth:school_portal_auth_dev@localhost:5432/school_portal?schema=public"

# Secret used to sign session cookies (HS256). Generate a strong random
# value for anything beyond local dev, e.g.: openssl rand -base64 32
SESSION_SECRET="dev-only-secret-change-me-please-32chars-min"
