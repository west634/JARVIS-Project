{
  "name": "sentinel-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API layer for the SENTINEL AI assistant (OpenAI + ElevenLabs proxy)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
