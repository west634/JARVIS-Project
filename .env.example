# Copy this file to .env and fill in your own secret values.
# Never commit the real .env file.

# OpenAI API key (server-side only, used for the reasoning/intelligence layer)
OPENAI_API_KEY=

# ElevenLabs API key (server-side only, used for text-to-speech)
ELEVENLABS_API_KEY=

# ElevenLabs voice ID to use for SENTINEL's voice
ELEVENLABS_VOICE_ID=

# Port the backend API server listens on
PORT=8787

# OpenAI chat model used for reasoning (override if you have a different model available)
OPENAI_MODEL=gpt-4o-mini
