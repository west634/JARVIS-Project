# Copy this file to .env and fill in your own secret values.
# Never commit the real .env file.

# ── Brain (reasoning) ───────────────────────────────────────────────────────
# Works with OpenAI OR any OpenAI-compatible API — including Google's free
# Gemini tier (no credit card required). For free Gemini:
#   1. Get a key at https://aistudio.google.com/apikey
#   2. OPENAI_API_KEY=<your Gemini key>
#   3. OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   4. OPENAI_MODEL=gemini-3.6-flash (or whatever Google's current model is —
#      if this name is outdated by the time you read this, the error message
#      you get back will name the current one)
# For paid OpenAI instead, just set OPENAI_API_KEY and leave OPENAI_BASE_URL blank.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ── Voice (text-to-speech) ──────────────────────────────────────────────────
# Optional. Leave both blank and the app automatically uses the browser's
# free built-in voice (Settings → Voice Provider → Browser). Fill these in
# only if you want the premium ElevenLabs voice instead.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Email search (optional) ─────────────────────────────────────────────────
# Lets SENTINEL search your inbox. Leave blank to disable the search_email
# tool entirely. Uses an IMAP "app password", not your real account password:
#   1. Turn on 2-Step Verification on your Google account (if not already on)
#   2. Generate one at https://myaccount.google.com/apppasswords
#   3. EMAIL_ADDRESS=you@gmail.com
#   4. EMAIL_APP_PASSWORD=<the 16-character app password>
# For a non-Gmail provider, also set EMAIL_IMAP_HOST to its IMAP server.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993

# Port the backend API server listens on
PORT=8787
