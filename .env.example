# Copy this file to .env and fill in your own secret values.
# Never commit the real .env file.

# ── Brain (reasoning) ───────────────────────────────────────────────────────
# Works with OpenAI OR any OpenAI-compatible API — including Google's free
# Gemini tier (no credit card required). For free Gemini:
#   1. Get a key at https://aistudio.google.com/apikey
#   2. OPENAI_API_KEY=<your Gemini key>
#   3. OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   4. OPENAI_MODEL=gemini-2.0-flash
# For paid OpenAI instead, just set OPENAI_API_KEY and leave OPENAI_BASE_URL blank.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ── Voice (text-to-speech) ──────────────────────────────────────────────────
# Optional. Leave both blank and the app automatically uses the browser's
# free built-in voice (Settings → Voice Provider → Browser). Fill these in
# only if you want the premium ElevenLabs voice instead.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Port the backend API server listens on
PORT=8787
